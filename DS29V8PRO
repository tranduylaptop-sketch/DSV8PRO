-- LOGIC PHANTOM MODE (TÀNG HÌNH)
-- ==========================================
local isPhantom = false
local RealChar, FakeChar = nil, nil

local function TogglePhantomLogic(state)
    isPhantom = state
    if isPhantom then
        RealChar = LocalPlayer.Character
        if not RealChar then return end
        
        RealChar.Archivable = true
        FakeChar = RealChar:Clone()
        FakeChar.Name = LocalPlayer.Name .. "_Phantom"
        FakeChar.Parent = workspace
        
        for _, v in pairs(FakeChar:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Decal") then
                if v.Name ~= "HumanoidRootPart" then v.Transparency = 0.5 end
            elseif v:IsA("Accessory") then
                local handle = v:FindFirstChild("Handle")
                if handle then handle.Transparency = 0.5 end
            end
        end
        
        LocalPlayer.Character = FakeChar
        Camera.CameraSubject = FakeChar:FindFirstChild("Humanoid")
        
        local oldAnim = RealChar:FindFirstChild("Animate")
        if oldAnim then
            local newAnim = oldAnim:Clone()
            newAnim.Parent = FakeChar
        end
    else
        if RealChar and FakeChar then
            local fakeRoot = FakeChar:FindFirstChild("HumanoidRootPart")
            local realRoot = RealChar:FindFirstChild("HumanoidRootPart")
            if fakeRoot and realRoot then realRoot.CFrame = fakeRoot.CFrame end
            
            LocalPlayer.Character = RealChar
            Camera.CameraSubject = RealChar:FindFirstChild("Humanoid")
            
            FakeChar:Destroy()
            FakeChar, RealChar = nil, nil
        end
    end
end


            pcall(function() currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            currentFPS = fpsFrames
            fpsFrames, fpsLastTick = 0, tick()
        end
        
        local themeColor = Color3.fromHSV(tick() % 4 / 4, 1, 1)
        if ThemeIndex == 2 then themeColor = Color3.fromRGB(255, 45, 45)
        elseif ThemeIndex == 3 then themeColor = Color3.fromRGB(50, 200, 255)
        elseif ThemeIndex == 4 then themeColor = Color3.fromRGB(50, 255, 90)
        elseif ThemeIndex == 5 then themeColor = Color3.fromRGB(200, 65, 255) end
        
        MainStroke.Color, IconStroke.Color, LogoStroke.Color, Title.TextColor3 = themeColor, themeColor, themeColor, themeColor
        FOVStroke.Color = themeColor
        WatermarkStroke.Color = themeColor
        EnemyCounter.TextColor3 = themeColor

        local date = os.date("!*t", os.time() + 7 * 3600)
        local timeStr = string.format("%02d:%02d:%02d", date.hour, date.min, date.sec)
        TimeLabel.Text = string.format("🇻🇳 Giờ VN: %s", timeStr)
        
        local fpsIcon = currentFPS >= 45 and "🟢" or (currentFPS >= 25 and "🟡" or "🔴")
        local pingIcon = currentPing <= 100 and "🟢" or (currentPing <= 250 and "🟡" or "🔴")
        StatsLabel.Text = string.format("%s FPS: %d | %s Ping: %d ms", fpsIcon, currentFPS, pingIcon, currentPing)

        WatermarkText.Text = string.format(" DS29 | User: %s | FPS: %d | Ping: %dms | %s", LocalPlayer.Name, currentFPS, currentPing, timeStr)
        WatermarkFrame.Size = UDim2.new(0, WatermarkText.TextBounds.X + 36, 0, 24)

        FOVCircle.Visible = Settings.ShowFOV
        FOVCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FOVCircle.Position = UDim2.new(0.5, -Settings.FOVRadius, 0.5, -Settings.FOVRadius)

        local currentTargetPart = nil
        if Settings.Aimbot or getgenv().DS29_SilentAim then
            local target = GetClosestTargetInFOV()
            if target and target.Character then
                currentTargetPart = target.Character:FindFirstChild(Settings.AimMode == "Đầu" and "Head" or "HumanoidRootPart")
            end
        end
        getgenv().DS29_GlobalTargetPart = currentTargetPart

        if currentTargetPart then
            local pos, onScreen = Camera:WorldToViewportPoint(currentTargetPart.Position)
            if onScreen and getgenv().DS29_SilentAim then
                TargetLockIndicator.Position = UDim2.new(0, pos.X, 0, pos.Y)
                TargetLockIndicator.Visible = true
                TargetLockIndicator.BackgroundColor3 = themeColor
            else
                TargetLockIndicator.Visible = false
            end
            
            -- CAMERA LOCK (BẮT DÍNH GẮT)
            if Settings.Aimbot then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTargetPart.Position)
            end
        else
            TargetLockIndicator.Visible = false
        end

        local visibleEnemies = 0
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local success, err = pcall(function()
                    if not ESP_Cache[player] then ESP_Cache[player] = CreateESP(player) end
                    local esp = ESP_Cache[player]
                    local char = player.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local head = char and char:FindFirstChild("Head")
                    
                    local isTeammate = (player.Team ~= nil and player.Team == LocalPlayer.Team)
                    local shouldShow = (isTeammate and Settings.ESP_Teammates) or (not isTeammate and Settings.ESP_Enemies)
                    
                    if char and hum and root and head and hum.Health > 0 and shouldShow and char.Parent ~= nil then
                        local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
                        local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))
                        
                        -- CẬP NHẬT HIỆU ỨNG CHAMS (VIỀN SÁNG)
                        if Settings.ShowHighlight then
                            esp.Highlight.Adornee = char
                            esp.Highlight.Parent = ESPScreen
                            esp.Highlight.FillColor = isTeammate and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
                            esp.Highlight.OutlineColor = isTeammate and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
                            esp.Highlight.Enabled = true
                        else
                            esp.Highlight.Enabled = false
                        end

                        if onScreen then
                            if not isTeammate then visibleEnemies = visibleEnemies + 1 end
                            local color = isTeammate and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
                            
                            local height = math.abs(headPos.Y - legPos.Y)
                            local width = height * 0.55
                            local boxX = rootPos.X - width/2
                            local boxY = headPos.Y
                            
                            esp.Box.Position = UDim2.new(0, boxX, 0, boxY)
                            esp.Box.Size = UDim2.new(0, width, 0, height)
                            esp.BoxStroke.Color = color
                            esp.Box.Visible = true
                            
                            local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                            esp.HealthBG.Position = UDim2.new(0, boxX - 7, 0, boxY)
                            esp.HealthBG.Size = UDim2.new(0, 3, 0, height)
                            esp.HealthFill.Size = UDim2.new(1, 0, hpRatio, 0)
                            esp.HealthFill.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
                            esp.HealthFill.BackgroundColor3 = Color3.fromRGB(255 - (hpRatio*255), hpRatio*255, 0)
                            esp.HealthBG.Visible = true
                            
                            local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
                            esp.InfoText.Position = UDim2.new(0, boxX, 0, boxY - 18)
                            esp.InfoText.Size = UDim2.new(0, width, 0, 15)
                            esp.InfoText.Text = player.Name .. " [" .. dist .. "m]"
                            esp.InfoText.TextColor3 = color
                            esp.InfoText.Visible = true

                            if Settings.ShowTracers then
                                DrawLine2D(esp.Tracer, Vector2.new(Camera.ViewportSize.X / 2, 0), Vector2.new(rootPos.X, boxY))
                                esp.Tracer.BackgroundColor3 = color
                                esp.Tracer.Visible = true
                            else esp.Tracer.Visible = false end

                            if Settings.ShowSkeleton then
                                UpdateSkeleton(char, esp, color)
                            else
                                for _, line in pairs(esp.SkeletonLines) do line.Visible = false end
                            end
                            
                            if not isTeammate and Settings.HitboxSize > 2 then
                                root.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                                root.Transparency = 0.65
                                root.CanCollide = false
                            else
                                root.Size = Vector3.new(2, 2, 1)
                                root.Transparency = 1
                            end
                        else
                            esp.Box.Visible = false
                            esp.Tracer.Visible = false
                            esp.HealthBG.Visible = false
                            esp.InfoText.Visible = false
                            for _, line in pairs(esp.SkeletonLines) do line.Visible = false end
                        end
                    else
                        esp.Box.Visible = false
                        esp.Tracer.Visible = false
                        esp.HealthBG.Visible = false
                        esp.InfoText.Visible = false
                        esp.Highlight.Enabled = false
                        for _, line in pairs(esp.SkeletonLines) do line.Visible = false end
                    end
                end)
                
                if not success and ESP_Cache[player] then
                    pcall(function()
                        ESP_Cache[player].Box.Visible = false
                        ESP_Cache[player].Tracer.Visible = false
                        ESP_Cache[player].HealthBG.Visible = false
                        ESP_Cache[player].InfoText.Visible = false
                        ESP_Cache[player].Highlight.Enabled = false
                        for _, line in pairs(ESP_Cache[player].SkeletonLines) do line.Visible = false end
                    end)
                end
            end
        end
        EnemyCounter.Text = "👤 Player: " .. visibleEnemies
        EnemyCounter.Visible = Settings.ESP_Enemies
    end)

    local stepConn
    stepConn = RunService.Stepped:Connect(function()
        if not ScreenGui or not ScreenGui.Parent then
            stepConn:Disconnect()
            return
        end
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and Settings.WalkSpeed > 16 then hum.WalkSpeed = Settings.WalkSpeed end
            
            if Settings.Fly and hrp and hum then
                hum.PlatformStand = true
                if not hrp:FindFirstChild("DS29_BV") then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "DS29_BV"
                    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bv.Velocity = Vector3.zero
                    bv.Parent = hrp
                    local bg = Instance.new("BodyGyro")
                    bg.Name = "DS29_BG"
                    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                    bg.P = 9e4
                    bg.CFrame = Camera.CFrame
                    bg.Parent = hrp
                end

                local moveVector = Vector3.zero
                if PlayerControl then pcall(function() moveVector = PlayerControl:GetMoveVector() end) end
                
                if moveVector == Vector3.zero then
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + Vector3.new(0,0,-1) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector + Vector3.new(0,0,1) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector + Vector3.new(-1,0,0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + Vector3.new(1,0,0) end
                end

                local bv = hrp:FindFirstChild("DS29_BV")
                local bg = hrp:FindFirstChild("DS29_BG")
                if bv and bg then
                    if moveVector.Magnitude > 0 then
                        local currentVelocity = (Camera.CFrame.RightVector * moveVector.X) + (Camera.CFrame.LookVector * -moveVector.Z)
                        bv.Velocity = currentVelocity.Unit * Settings.WalkSpeed
                    else
                        bv.Velocity = Vector3.zero
                    end
                    bg.CFrame = Camera.CFrame
                end
            elseif not Settings.Fly and hrp and hum then
                hum.PlatformStand = false
                if hrp:FindFirstChild("DS29_BV") then hrp.DS29_BV:Destroy() end
                if hrp:FindFirstChild("DS29_BG") then hrp.DS29_BG:Destroy() end
            end
            
            if Settings.Noclip then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end)
    
    local jumpConn
    jumpConn = UserInputService.JumpRequest:Connect(function()
        if not ScreenGui or not ScreenGui.Parent then
            jumpConn:Disconnect()
            return
        end
        if Settings.InfJump and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
    
    local plConn
    plConn = Players.PlayerRemoving:Connect(function(player)
        if not ScreenGui or not ScreenGui.Parent then
            plConn:Disconnect()
            return
        end
        if ESP_Cache[player] then
            for _, obj in pairs(ESP_Cache[player]) do
                if typeof(obj) == "table" then
                    for _, line in pairs(obj) do line:Destroy() end
                else
                    obj:Destroy()
                end
            end
            ESP_Cache[player] = nil
        end
    end)

    SendNotification("⚡️ DS29 VIP ⚡️", "Chào mừng " .. LocalPlayer.Name .. "!\nScript đã load thành công.", 6)
end


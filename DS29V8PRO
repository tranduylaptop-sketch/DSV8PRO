-- HOOK METATABLE V59 (MAX DAME - NO MISS)
-- ==========================================
pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    local oldIndex = mt.__index
    
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }
        local argCount = select("#", ...)
        
        -- Chống Kick
        if getgenv().DS29_AntiKick and not checkcaller() then
            if self == LocalPlayer and (method == "Kick" or method == "kick") then return nil end
            if method == "FireServer" or method == "InvokeServer" then
                local remoteName = tostring(self):lower()
                if remoteName:match("votekick") or remoteName:match("kick") then return nil end
            end
        end
        
        -- Silent Aim Nguyên Thủy (Bách Phát Bách Trúng)
        if getgenv().DS29_SilentAim and getgenv().DS29_GlobalTargetPart and not checkcaller() then
            local targetPart = getgenv().DS29_GlobalTargetPart
            if typeof(targetPart) == "Instance" and targetPart.Parent ~= nil then
                local targetPos = targetPart.Position
                
                -- Đoán điểm rơi cực gắt
                if targetPart.Parent:FindFirstChild("HumanoidRootPart") then
                    targetPos = targetPos + (targetPart.Parent.HumanoidRootPart.Velocity * 0.055)
                end

                if method == "Raycast" and self == workspace then
                    if args[1] and args[2] and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                        args[2] = (targetPos - args[1]).Unit * (args[2].Magnitude > 0 and args[2].Magnitude or 1000)
                        return oldNamecall(self, unpack(args, 1, argCount))
                    end
                elseif (method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay") and self == workspace then
                    if args[1] and typeof(args[1]) == "Ray" then
                        args[1] = Ray.new(args[1].Origin, (targetPos - args[1].Origin).Unit * 1000)
                        return oldNamecall(self, unpack(args, 1, argCount))
                    end
                elseif method == "FireServer" or method == "InvokeServer" then
                    local remoteStr = tostring(self):lower()
                    if remoteStr:match("shoot") or remoteStr:match("fire") or remoteStr:match("bullet") or remoteStr:match("hit") or remoteStr:match("damage") or remoteStr:match("mouse") then
                        for i, v in ipairs(args) do
                            if typeof(v) == "Vector3" and (v - Camera.CFrame.Position).Magnitude > 5 then
                                args[i] = targetPos
                            elseif typeof(v) == "CFrame" then
                                args[i] = CFrame.new(v.Position, targetPos)
                            end
                        end
                        return oldNamecall(self, unpack(args, 1, argCount))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    mt.__index = newcclosure(function(self, key)
        if getgenv().DS29_SilentAim and not checkcaller() and getgenv().DS29_GlobalTargetPart then
            if self == PlayerMouse then
                local targetPart = getgenv().DS29_GlobalTargetPart
                if typeof(targetPart) == "Instance" and targetPart.Parent ~= nil then
                    local targetPos = targetPart.Position
                    if key == "Hit" or key == "hit" then return CFrame.new(targetPos)
                    elseif key == "Target" or key == "target" then return targetPart
                    elseif key == "UnitRay" or key == "unitRay" then
                        local origin = Camera.CFrame.Position
                        return Ray.new(origin, (targetPos - origin).Unit)
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    
    setreadonly(mt, true)
end)


    local function DrawLine2D(frame, p1, p2)
        local center = (p1 + p2) / 2
        local vec = p2 - p1
        frame.Position = UDim2.new(0, center.X, 0, center.Y)
        frame.Size = UDim2.new(0, vec.Magnitude, 0, 2)
        frame.Rotation = math.deg(math.atan2(vec.Y, vec.X))
    end


    local function GetBonePos(char, partName, attachmentName, offsetCFrame)
        local part = char:FindFirstChild(partName)
        if part then
            if attachmentName then
                local att = part:FindFirstChild(attachmentName)
                if att then return att.WorldPosition end
            end
            if offsetCFrame then
                return (part.CFrame * offsetCFrame).Position
            end
            return part.Position
        end
        return nil
    end

    local function UpdateSkeleton(char, esp, color)
        local isR15 = char:FindFirstChild("UpperTorso") ~= nil
        local bones = {}

        if isR15 then
            local head = GetBonePos(char, "Head", "NeckRigAttachment") or GetBonePos(char, "Head")
            local uTorsoTop = GetBonePos(char, "UpperTorso", "NeckRigAttachment") or GetBonePos(char, "UpperTorso")
            local uTorsoBot = GetBonePos(char, "UpperTorso", "WaistRigAttachment") or GetBonePos(char, "UpperTorso")
            local lTorsoBot = GetBonePos(char, "LowerTorso", "RootRigAttachment") or GetBonePos(char, "LowerTorso")
            
            local lShoulder = GetBonePos(char, "LeftUpperArm", "LeftShoulderRigAttachment") or GetBonePos(char, "LeftUpperArm")
            local lElbow = GetBonePos(char, "LeftLowerArm", "LeftElbowRigAttachment") or GetBonePos(char, "LeftLowerArm")
            local lHand = GetBonePos(char, "LeftHand", "LeftWristRigAttachment") or GetBonePos(char, "LeftHand")
            local lHandEnd = char:FindFirstChild("LeftHand") and GetBonePos(char, "LeftHand", nil, CFrame.new(0, -char.LeftHand.Size.Y/2, 0)) or lHand

            local rShoulder = GetBonePos(char, "RightUpperArm", "RightShoulderRigAttachment") or GetBonePos(char, "RightUpperArm")
            local rElbow = GetBonePos(char, "RightLowerArm", "RightElbowRigAttachment") or GetBonePos(char, "RightLowerArm")
            local rHand = GetBonePos(char, "RightHand", "RightWristRigAttachment") or GetBonePos(char, "RightHand")
            local rHandEnd = char:FindFirstChild("RightHand") and GetBonePos(char, "RightHand", nil, CFrame.new(0, -char.RightHand.Size.Y/2, 0)) or rHand

            local lHip = GetBonePos(char, "LeftUpperLeg", "LeftHipRigAttachment") or GetBonePos(char, "LeftUpperLeg")
            local lKnee = GetBonePos(char, "LeftLowerLeg", "LeftKneeRigAttachment") or GetBonePos(char, "LeftLowerLeg")
            local lAnkle = GetBonePos(char, "LeftFoot", "LeftAnkleRigAttachment") or GetBonePos(char, "LeftFoot")
            local lFootEnd = char:FindFirstChild("LeftFoot") and GetBonePos(char, "LeftFoot", nil, CFrame.new(0, -char.LeftFoot.Size.Y/2, 0)) or lAnkle

            local rHip = GetBonePos(char, "RightUpperLeg", "RightHipRigAttachment") or GetBonePos(char, "RightUpperLeg")
            local rKnee = GetBonePos(char, "RightLowerLeg", "RightKneeRigAttachment") or GetBonePos(char, "RightLowerLeg")
            local rAnkle = GetBonePos(char, "RightFoot", "RightAnkleRigAttachment") or GetBonePos(char, "RightFoot")
            local rFootEnd = char:FindFirstChild("RightFoot") and GetBonePos(char, "RightFoot", nil, CFrame.new(0, -char.RightFoot.Size.Y/2, 0)) or rFootEnd

            bones = {
                {head, uTorsoTop}, {uTorsoTop, uTorsoBot}, {uTorsoBot, lTorsoBot}, 
                {uTorsoTop, lShoulder}, {lShoulder, lElbow}, {lElbow, lHand}, {lHand, lHandEnd}, 
                {uTorsoTop, rShoulder}, {rShoulder, rElbow}, {rElbow, rHand}, {rHand, rHandEnd},
                {lTorsoBot, lHip}, {lHip, lKnee}, {lKnee, lAnkle}, {lAnkle, lFootEnd}, 
                {lTorsoBot, rHip}, {rHip, rKnee}, {rKnee, rAnkle}, {rAnkle, rFootEnd} 
            }
        else
            local head = GetBonePos(char, "Head")
            local torso = GetBonePos(char, "Torso")
            
            local lArm = GetBonePos(char, "Left Arm")
            local lArmEnd = char:FindFirstChild("Left Arm") and GetBonePos(char, "Left Arm", nil, CFrame.new(0, -char["Left Arm"].Size.Y/2, 0)) or lArm
            
            local rArm = GetBonePos(char, "Right Arm")
            local rArmEnd = char:FindFirstChild("Right Arm") and GetBonePos(char, "Right Arm", nil, CFrame.new(0, -char["Right Arm"].Size.Y/2, 0)) or rArm
            
            local lLeg = GetBonePos(char, "Left Leg")
            local lLegEnd = char:FindFirstChild("Left Leg") and GetBonePos(char, "Left Leg", nil, CFrame.new(0, -char["Left Leg"].Size.Y/2, 0)) or lLeg
            
            local rLeg = GetBonePos(char, "Right Leg")
            local rLegEnd = char:FindFirstChild("Right Leg") and GetBonePos(char, "Right Leg", nil, CFrame.new(0, -char["Right Leg"].Size.Y/2, 0)) or rLeg

            if head and torso then
                bones = {
                    {head, torso},
                    {torso, lArm}, {lArm, lArmEnd},
                    {torso, rArm}, {rArm, rArmEnd},
                    {torso, lLeg}, {lLeg, lLegEnd},
                    {torso, rLeg}, {rLeg, rLegEnd}
                }
            end
        end

        local lineIndex = 1
        for _, conn in ipairs(bones) do
            if conn[1] and conn[2] then
                local p1, on1 = Camera:WorldToViewportPoint(conn[1])
                local p2, on2 = Camera:WorldToViewportPoint(conn[2])

                if on1 and on2 then
                    local frame = esp.SkeletonLines[lineIndex]
                    if frame then
                        DrawLine2D(frame, Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y))
                        frame.BackgroundColor3 = color
                        frame.Visible = true
                        lineIndex = lineIndex + 1
                    end
                end
            end
        end

        for i = lineIndex, #esp.SkeletonLines do
            esp.SkeletonLines[i].Visible = false
        end
    end


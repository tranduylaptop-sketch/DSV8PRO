    local function GetClosestTargetInFOV()
        local closestPlayer = nil
        local shortestDistance = Settings.FOVRadius

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and (player.Team == nil or player.Team ~= LocalPlayer.Team) then
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and char:FindFirstChild("HumanoidRootPart") then
                    local targetPart = char:FindFirstChild(Settings.AimMode == "Đầu" and "Head" or "HumanoidRootPart")
                    if targetPart then
                        local targetPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                            local dist = (Vector2.new(targetPos.X, targetPos.Y) - screenCenter).Magnitude
                            if dist <= Settings.FOVRadius and dist < shortestDistance then
                                shortestDistance = dist
                                closestPlayer = player
                            end
                        end
                    end
                end
            end
        end
        return closestPlayer
    end

    local function GetNextTarget()
        local validPlayers = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (p.Team == nil or p.Team ~= LocalPlayer.Team) then table.insert(validPlayers, p) end
        end
        if #validPlayers == 0 then return nil end
        TargetIndex = TargetIndex + 1
        if TargetIndex > #validPlayers then TargetIndex = 1 end
        return validPlayers[TargetIndex]
    end

